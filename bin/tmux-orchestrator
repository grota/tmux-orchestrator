#!/usr/bin/env bash
# Shared reporter for tmux-orchestrator.  Adapters forward agent events to it;
# it applies them through the agent state module, stores agents in pane option
# slots, and never blocks an agent for longer than a few tmux commands.
set -u

SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
ROOT_DIR=$(cd "$SELF_DIR/.." && pwd)
# shellcheck source=../lib/agent-state.sh
. "$ROOT_DIR/lib/agent-state.sh"

TMUX_BIN=${TMUX_BIN:-tmux}
# Not named TMUX: assigning an array to it drops tmux's own TMUX variable
# from every command, which then talks to the default server.
TMUX_CMD=("$TMUX_BIN")
if [[ -n ${TMUX_SOCKET:-} ]]; then
	TMUX_CMD+=(-L "$TMUX_SOCKET")
fi

# The report protocol adapters speak.  It changes only when the commands
# adapters call change incompatibly.
PROTOCOL=1

# Agents past this slot are shown as one overflow row (ADR-0004).  The sidebar
# format holds the number, so both sides agree.
VISIBLE_SLOTS=9
while IFS= read -r line; do
	[[ $line == slots=* ]] && VISIBLE_SLOTS=${line#slots=}
done <"$ROOT_DIR/lib/sidebar-format"
SLOT_FIELDS='sid kind state since name name_raw event notified_at'
US=$'\x1f'
RS=$'\x1e'

tmux_do() {
	"${TMUX_CMD[@]}" "$@" 2>/dev/null
}

tmux_ok() {
	tmux_do "$@" >/dev/null 2>&1
}

# Writes are queued and sent as one tmux call, which stops at the first failing
# command, so a batch holds the writes of one pane or one session.
BATCH=()

# tmux ends a command at an argument ending in ";", so that ";" is escaped.
queue() {
	local arg
	for arg in "$@"; do
		[[ $arg == *';' ]] && arg="${arg%;}\\;"
		BATCH+=("$arg")
	done
	BATCH+=(';')
}

flush() {
	((${#BATCH[@]})) || return 0
	tmux_ok "${BATCH[@]}"
	BATCH=()
}

get_global() {
	tmux_do show-options -gv "$1" || true
}

get_pane_opt() {
	tmux_do show-options -pv -t "$1" "$2" || true
}

set_pane_opt() {
	tmux_ok set-option -p -t "$1" "$2" "$3"
}

unset_pane_opt() {
	tmux_ok set-option -pu -t "$1" "$2"
}

unset_session_opt() {
	tmux_ok set-option -u -t "$1" "$2"
}

refresh_clients() {
	tmux_ok refresh-client -S || true
	return 0
}

state_icon() {
	case "$1" in
	working) printf '◐' ;;
	blocked) printf '●' ;;
	error) printf '×' ;;
	done) printf '✓' ;;
	idle) printf '○' ;;
	*) printf '·' ;;
	esac
}

sanitize_name() {
	local value=$1
	value=${value//$'\r'/ }
	value=${value//$'\n'/ }
	value=$(printf '%s' "$value" | tr -d '\000-\011\013\014\016-\037\177' 2>/dev/null || printf '%s' "$value")
	# Keep one line and avoid leading/trailing whitespace creating empty rows.
	value="${value#"${value%%[![:space:]]*}"}"
	value="${value%"${value##*[![:space:]]}"}"
	printf '%s' "$value"
}

escape_hash() {
	printf '%s' "${1//#/##}"
}

fallback_name() {
	local pane=$1 cwd=${2-} base
	if [[ -z $cwd ]]; then
		cwd=$(tmux_do display-message -p -t "$pane" '#{pane_current_path}' || true)
	fi
	if [[ -z $cwd ]]; then
		cwd=${PWD:-}
	fi
	base=$(basename -- "$cwd" 2>/dev/null || true)
	if [[ -z $base || $base == / ]]; then
		base=$(tmux_do display-message -p -t "$pane" '#{pane_index}' || true)
	fi
	[[ -n $base ]] || base=agent
	printf '%s' "$base"
}

pane_session() {
	tmux_do display-message -p -t "$1" '#{session_id}' || true
}

# --- Pane agent slots --------------------------------------------------------
#
# A pane stores its agents in numbered slots, in tab order:
#   @agent_n, @agent_<i>_{sid,kind,state,since,name,name_raw,event,notified_at},
#   @agent_active, @agent_pane_rollup, @agent_pane_waiting, @agent_more_n,
#   @agent_more_state,
#   @agent_socket.
# Pane options must not reuse a session option's name: tmux resolves a user
# option through the pane first, so a pane-level @agent_rollup would shadow
# the session rollup on the sidebar's session rows.
# load_pane fills these globals; store_pane writes them back.

N=0
LOADED_N=0
ACTIVE=''
WAITERS=''
SID=()
KIND=()
STATE=()
RAW=()
EVENT=()
NOTIFIED=()
SINCE=()

load_pane() {
	local pane=$1 i format
	SID=()
	KIND=()
	STATE=()
	RAW=()
	EVENT=()
	NOTIFIED=()
	SINCE=()
	IFS=$US read -r N ACTIVE WAITERS <<<"$(tmux_do display-message -p -t "$pane" \
		"#{@agent_n}$US#{@agent_active}$US#{@agent_1_waiters}" || true)"
	[[ $N =~ ^[0-9]+$ ]] || N=0
	LOADED_N=$N
	((N > 0)) || return 0
	format=''
	for ((i = 1; i <= N; i++)); do
		format+="#{@agent_${i}_sid}$US#{@agent_${i}_kind}$US#{@agent_${i}_state}$US#{@agent_${i}_name_raw}$US#{@agent_${i}_event}$US#{@agent_${i}_notified_at}$US#{@agent_${i}_since}$RS"
	done
	i=1
	while IFS=$US read -r -d "$RS" SID[i] KIND[i] STATE[i] RAW[i] EVENT[i] NOTIFIED[i] SINCE[i]; do
		i=$((i + 1))
	done <<<"$(tmux_do display-message -p -t "$pane" "$format" || true)"
}

write_slot() {
	local pane=$1 i=$2
	queue set-option -p -t "$pane" "@agent_${i}_sid" "${SID[i]-}"
	queue set-option -p -t "$pane" "@agent_${i}_kind" "${KIND[i]-}"
	queue set-option -p -t "$pane" "@agent_${i}_state" "$(agent_valid_state "${STATE[i]-}")"
	queue set-option -p -t "$pane" "@agent_${i}_since" "${SINCE[i]-}"
	queue set-option -p -t "$pane" "@agent_${i}_name" "$(escape_hash "${RAW[i]-}")"
	queue set-option -p -t "$pane" "@agent_${i}_name_raw" "${RAW[i]-}"
	queue set-option -p -t "$pane" "@agent_${i}_event" "${EVENT[i]-}"
	if [[ -n ${NOTIFIED[i]-} ]]; then
		queue set-option -p -t "$pane" "@agent_${i}_notified_at" "${NOTIFIED[i]}"
	else
		queue set-option -pu -t "$pane" "@agent_${i}_notified_at"
	fi
}

clear_slot() {
	local pane=$1 i=$2 field
	for field in $SLOT_FIELDS; do
		queue set-option -pu -t "$pane" "@agent_${i}_${field}"
	done
}

# Pane rollup and overflow row, from the loaded slots.
write_pane_summary() {
	local pane=$1 i states=() extra=()
	for ((i = 1; i <= N; i++)); do
		states+=("${STATE[i]-}")
		((i > VISIBLE_SLOTS)) && extra+=("${STATE[i]-}")
	done
	if ((N == 0)); then
		clear_pane "$pane"
		return 0
	fi
	queue set-option -p -t "$pane" @agent_n "$N"
	queue set-option -p -t "$pane" @agent_pane_rollup "$(agent_rollup "${states[@]}")"
	queue set-option -p -t "$pane" @agent_pane_waiting "$(waiting_counts "${states[@]}")"
	if ((${#extra[@]} > 0)); then
		queue set-option -p -t "$pane" @agent_more_n "${#extra[@]}"
		queue set-option -p -t "$pane" @agent_more_state "$(agent_rollup "${extra[@]}")"
	else
		queue set-option -pu -t "$pane" @agent_more_n
		queue set-option -pu -t "$pane" @agent_more_state
	fi
	if [[ ! $ACTIVE =~ ^[0-9]+$ ]] || ((ACTIVE < 1 || ACTIVE > N)); then
		ACTIVE=1
	fi
	queue set-option -p -t "$pane" @agent_active "$ACTIVE"
}

# Rewrite every slot after slots were added, removed or reordered.
store_pane() {
	local pane=$1 i
	for ((i = 1; i <= N; i++)); do
		write_slot "$pane" "$i"
	done
	for ((i = N + 1; i <= LOADED_N; i++)); do
		clear_slot "$pane" "$i"
	done
	write_pane_summary "$pane"
}

# Remove slot I from the loaded arrays, shifting later slots down.
drop_slot() {
	local i=$1 j
	for ((j = i; j < N; j++)); do
		SID[j]=${SID[j + 1]-}
		KIND[j]=${KIND[j + 1]-}
		STATE[j]=${STATE[j + 1]-}
		RAW[j]=${RAW[j + 1]-}
		EVENT[j]=${EVENT[j + 1]-}
		NOTIFIED[j]=${NOTIFIED[j + 1]-}
		SINCE[j]=${SINCE[j + 1]-}
	done
	unset 'SID[N]' 'KIND[N]' 'STATE[N]' 'RAW[N]' 'EVENT[N]' 'NOTIFIED[N]' 'SINCE[N]'
	if [[ $ACTIVE =~ ^[0-9]+$ ]]; then
		if ((ACTIVE == i)); then
			ACTIVE=1
		elif ((ACTIVE > i)); then
			ACTIVE=$((ACTIVE - 1))
		fi
	fi
	N=$((N - 1))
}

# Give slot I a new state, recording when it changed for the sidebar's
# time-in-state.
set_state() {
	local i=$1 state=$2
	[[ ${STATE[i]-} == "$state" && -n ${SINCE[i]-} ]] && return 0
	[[ ${STATE[i]-} == "$state" ]] || STATE[i]=$state
	SINCE[i]=$(date +%s)
}

find_slot() {
	local sid=$1 i
	for ((i = 1; i <= N; i++)); do
		if [[ ${SID[i]-} == "$sid" ]]; then
			printf '%s' "$i"
			return 0
		fi
	done
}

# Every @agent_* pane option, old layout included, found by listing.
clear_pane() {
	local pane=$1 name _
	while read -r name _; do
		[[ $name == @agent_* ]] && queue set-option -pu -t "$pane" "$name"
	done < <(tmux_do show-options -p -t "$pane" || true)
}

# "BLOCKED ERROR DONE": how many of the given states need the user.
waiting_counts() {
	local state blocked=0 error=0 finished=0
	for state in "$@"; do
		case "$state" in
		blocked) blocked=$((blocked + 1)) ;;
		error) error=$((error + 1)) ;;
		done) finished=$((finished + 1)) ;;
		esac
	done
	printf '%s %s %s' "$blocked" "$error" "$finished"
}

# Session totals.  @agent_waiting_w is the width the waiting counts take on the
# session row, so the session name is truncated to leave room for them.
recompute_session() {
	local sid=$1 n rollup waiting count=0 states=() b e d blocked=0 error=0 finished=0 width=0 name value
	while IFS=$US read -r n rollup waiting; do
		[[ $n =~ ^[0-9]+$ ]] || continue
		((n > 0)) || continue
		count=$((count + n))
		states+=("$rollup")
		read -r b e d <<<"$waiting"
		[[ $b$e$d =~ ^[0-9]+$ ]] || continue
		blocked=$((blocked + b)) error=$((error + e)) finished=$((finished + d))
	done < <(tmux_do list-panes -s -t "$sid" -F "#{@agent_n}$US#{@agent_pane_rollup}$US#{@agent_pane_waiting}" || true)
	queue set-option -t "$sid" @agent_count "$count"
	if ((count == 0)); then
		queue set-option -u -t "$sid" @agent_rollup
	else
		queue set-option -t "$sid" @agent_rollup "$(agent_rollup "${states[@]}")"
	fi
	for name in blocked error done; do
		value=$blocked
		[[ $name == error ]] && value=$error
		[[ $name == done ]] && value=$finished
		if ((value > 0)); then
			queue set-option -t "$sid" "@agent_${name}_n" "$value"
			width=$((width + ${#value} + 2))
		else
			queue set-option -u -t "$sid" "@agent_${name}_n"
		fi
	done
	queue set-option -t "$sid" @agent_waiting_w "$width"
	flush
}

# Send the pane's queued writes, then update its session and redraw.
after_pane_change() {
	local pane=$1 session
	flush
	session=$(pane_session "$pane")
	[[ -n $session ]] && recompute_session "$session"
	refresh_clients
}

remove_pane() {
	local pane=$1
	clear_pane "$pane"
	after_pane_change "$pane"
}

# --- Viewing and notifications ----------------------------------------------

# The slot a client sees in a pane: the active tab, or the only agent.
viewed_slot() {
	local pane=$1 n active
	n=$(get_pane_opt "$pane" @agent_n)
	[[ $n =~ ^[0-9]+$ ]] && ((n > 0)) || return 0
	active=$(get_pane_opt "$pane" @agent_active)
	[[ $active =~ ^[0-9]+$ ]] || active=1
	printf '%s' "$active"
}

client_views() {
	local cpane=$1 pane=$2 slot=$3
	[[ $cpane == "$pane" ]] || return 1
	[[ $(viewed_slot "$pane") == "$slot" ]]
}

# Succeeds when notification channel NAME (tmux, desktop or terminal) is on.
# A missing or unrecognised value means DEFAULT.
channel_on() {
	local value
	value=$(get_global "@tmux-orchestrator-notify-$1")
	case "$value" in
	on | off) [[ $value == on ]] ;;
	*) [[ $2 == on ]] ;;
	esac
}

desktop_command() {
	if command -v notify-send >/dev/null 2>&1; then
		printf notify-send
	elif command -v osascript >/dev/null 2>&1; then
		printf osascript
	fi
}

notify_desktop() {
	local name=$1 state=$2 icon summary cmd escaped
	icon=$(state_icon "$state")
	summary="$icon Agent $state: $name"
	cmd=$(desktop_command)
	[[ -n $cmd ]] || return 0
	case "$cmd" in
	notify-send)
		notify-send -a tmux-orchestrator "$summary" >/dev/null 2>&1 || true
		;;
	osascript)
		escaped=${summary//\\/\\\\}
		escaped=${escaped//\"/\\\"}
		osascript -e "display notification \"$escaped\" with title \"tmux-orchestrator\"" >/dev/null 2>&1 || true
		;;
	esac
}

# Notify for slot I of PANE, which just entered STATE.  Uses the loaded slots.
notify_agent() {
	local pane=$1 i=$2 state=$3 name=${RAW[$2]-}
	local paused icon msg client cpane any_view=0 tmux_allowed=1
	local last now sent=0 tmux=0 desktop=0 terminal=0

	paused=$(get_global @tmux-orchestrator-notify-paused)
	[[ $paused == 1 ]] && return 0

	channel_on tmux on && tmux=1
	channel_on desktop on && desktop=1
	channel_on terminal off && terminal=1
	((tmux + desktop + terminal)) || return 0

	icon=$(state_icon "$state")
	msg="$icon $name $state"

	# Channels outside tmux are suppressed if any client is already viewing.
	while IFS=' ' read -r client cpane; do
		[[ -n $cpane ]] || continue
		client_views "$cpane" "$pane" "$i" && any_view=1
	done < <(tmux_do list-clients -F '#{client_name} #{pane_id}' || true)

	if ((tmux)); then
		if [[ $state == done ]]; then
			last=${NOTIFIED[i]-}
			now=$(date +%s)
			if [[ -n $last && $last =~ ^[0-9]+$ ]] && ((now - last < 2)); then
				tmux_allowed=0
			fi
		fi
		if ((tmux_allowed)); then
			while IFS=' ' read -r client cpane; do
				[[ -n $client ]] || continue
				client_views "$cpane" "$pane" "$i" && continue
				tmux_ok display-message -l -c "$client" "$msg" && sent=1
			done < <(tmux_do list-clients -F '#{client_name} #{pane_id}' || true)
			if ((sent)); then
				NOTIFIED[i]=$(date +%s)
				set_pane_opt "$pane" "@agent_${i}_notified_at" "${NOTIFIED[i]}"
			fi
		fi
	fi

	if ((any_view == 0)); then
		((desktop)) && notify_desktop "$name" "$state"
		((terminal)) && notify_terminal "$name" "$state"
	fi
	return 0
}

# --- Agent events -------------------------------------------------------------

spawn_name_refresh() {
	local pane=$1 sid=$2 bin=$3 cmd
	[[ -n $sid && -n $bin ]] || return 0
	cmd=$(printf '%q ' "$SELF_DIR/tmux-orchestrator" refresh-name --pane "$pane" --session-id "$sid" --claude-bin "$bin")
	[[ -n ${TMUX_SOCKET:-} ]] && cmd="TMUX_SOCKET=$(printf '%q' "$TMUX_SOCKET") $cmd"
	tmux_ok run-shell -b "$cmd"
}

event_label() {
	local kind=$1 event=$2 detail=${3-}
	if [[ -n $detail ]]; then
		printf '%s:%s:%s' "$kind" "$event" "$detail"
	else
		printf '%s:%s' "$kind" "$event"
	fi
}

report_event() {
	local pane=$1 kind=$2 event=$3 detail=$4 sid=$5 name=$6 cwd=$7 refresh=$8 actor=${9-} attached=${10-}
	local i verb next notify raw waiters='' waiting=0

	[[ -n $pane && -n $kind && -n $event ]] || return 0
	load_pane "$pane"

	# A Claude pane holds one agent; a new session ID (resume, /clear) replaces it.
	if [[ $kind == claude ]]; then
		((N > 0)) && i=1 || i=''
	elif [[ -n $sid ]]; then
		i=$(find_slot "$sid")
	else
		i=${ACTIVE:-}
		((N > 0)) || i=''
	fi

	# A Claude agent stays blocked while any of its actors (main or a subagent)
	# still waits for the user.
	if [[ $kind == claude ]]; then
		waiters=$(agent_waiters "$WAITERS" "$kind" "$event" "$detail" "$actor")
		[[ -n $waiters ]] && waiting=1
	fi

	read -r verb next notify <<<"$(agent_transition "${i:+${STATE[i]-}}" "$kind" "$event" "$detail" "$waiting")"

	if [[ $verb == forget ]]; then
		[[ -n $i ]] || return 0
		drop_slot "$i"
		store_pane "$pane"
		after_pane_change "$pane"
		return 0
	fi

	# A new Claude session in the pane starts its own time in state.
	[[ $kind == claude && -n $i && -n $sid && ${SID[i]-} != "$sid" ]] && SINCE[i]=''

	# An event that changes no state never creates an agent.
	if [[ -z $i ]]; then
		[[ $verb == set ]] || return 0
		N=$((N + 1))
		i=$N
		SID[i]=''
		RAW[i]=''
		NOTIFIED[i]=''
	fi

	[[ $verb == set ]] && set_state "$i" "$next"
	KIND[i]=$kind
	[[ -n $sid ]] && SID[i]=$sid
	EVENT[i]=$(event_label "$kind" "$event" "$detail")

	raw=''
	[[ -n $name ]] && raw=$(sanitize_name "$name")
	[[ -n $raw ]] && RAW[i]=$raw
	[[ -n ${RAW[i]-} ]] || RAW[i]=$(fallback_name "$pane" "$cwd")

	write_slot "$pane" "$i"
	write_pane_summary "$pane"
	# A Claude pane either runs its agent or shows an attached background one.
	if [[ $kind == claude ]]; then
		if [[ -n $attached ]]; then
			queue set-option -p -t "$pane" @agent_attached "$attached"
		else
			queue set-option -pu -t "$pane" @agent_attached
		fi
	fi
	if [[ $kind == claude && $waiters != "$WAITERS" ]]; then
		if [[ -n $waiters ]]; then
			queue set-option -p -t "$pane" @agent_1_waiters "$waiters"
		else
			queue set-option -pu -t "$pane" @agent_1_waiters
		fi
	fi
	after_pane_change "$pane"

	[[ $verb == set && $notify == 1 ]] && notify_agent "$pane" "$i" "$next"

	if [[ $kind == claude && $event == UserPromptSubmit ]]; then
		start_interrupt_watch "$pane" "${SID[i]-}"
	fi

	if [[ $refresh == 1 && -n ${SID[i]-} ]]; then
		local claude_bin=${CLAUDE_BIN:-}
		[[ -n $claude_bin ]] || claude_bin=$(command -v claude 2>/dev/null || true)
		spawn_name_refresh "$pane" "${SID[i]}" "$claude_bin"
	fi
}

# Claude Code sends no hook for an interrupt (ADR-0010).  While a turn runs,
# one watcher per pane reads the session's status from Claude's session
# registry.  Two idle readings in a row while the agent is still working or
# blocked mean the turn ended without a Stop hook; one reading could race the
# Stop hook of a turn that just completed.  A new token in @agent_1_watch
# retires the previous watcher.
start_interrupt_watch() {
	local pane=$1 sid=$2 token cmd var
	[[ -n $sid ]] || return 0
	token="$(date +%s)-$$-$RANDOM"
	set_pane_opt "$pane" @agent_1_watch "$token"
	cmd=$(printf '%q ' "$SELF_DIR/tmux-orchestrator" watch-interrupt --pane "$pane" --session-id "$sid" --token "$token")
	# run-shell uses the server's environment, so pass ours through explicitly.
	for var in TMUX_SOCKET TMUX_ORCHESTRATOR_WATCH_TICK CLAUDE_CONFIG_DIR; do
		[[ -n ${!var:-} ]] && cmd="$var=$(printf '%q' "${!var}") $cmd"
	done
	tmux_ok run-shell -b "$cmd"
}

watch_interrupt() {
	local pane=$1 sid=$2 token=$3
	local tick=${TMUX_ORCHESTRATOR_WATCH_TICK:-2} registry='' misses=0 idle=0 entry
	[[ -n $pane && -n $sid && -n $token ]] || return 0
	while sleep "$tick"; do
		[[ $(get_pane_opt "$pane" @agent_1_watch) == "$token" ]] || return 0
		case "$(get_pane_opt "$pane" @agent_1_state)" in
		working | blocked) ;;
		*) return 0 ;;
		esac
		# The entry can lag the first prompt of a new session.
		if [[ -z $registry ]]; then
			registry=$(claude_registry_file "$sid")
			if [[ -z $registry ]]; then
				misses=$((misses + 1))
				((misses < 5)) || return 0
				continue
			fi
		fi
		# A missing entry or another session ID means the session ended or
		# was replaced, and its own events take over.
		entry=$(jq -r '"\(.sessionId) \(.status // "")"' "$registry" 2>/dev/null) || return 0
		[[ ${entry%% *} == "$sid" ]] || return 0
		if [[ ${entry#* } == idle ]]; then
			idle=$((idle + 1))
		else
			idle=0
		fi
		if ((idle >= 2)); then
			unset_pane_opt "$pane" @agent_1_watch
			report_event "$pane" claude Interrupted '' '' '' '' 0 main
			return 0
		fi
	done
}

# Apply an OpenCode tab snapshot: the ordered tabs with their status and title,
# and the active tab.  Differences become tab.opened, tab.closed and
# tab.focused agent events.
apply_tabs() {
	local pane=$1 active_sid=$2 cwd=$3
	shift 3
	local -a tab_sid=() tab_status=() tab_title=()
	local -a new_sid=() new_kind=() new_state=() new_raw=() new_event=() new_notified=() new_since=() old_state=()
	local count=0 i j old_active_sid='' new_active='' verb next notify raw slot
	local -a pending_notify=()

	while (($# >= 3)); do
		tab_sid+=("$1")
		tab_status+=("$2")
		tab_title+=("$3")
		shift 3
		count=$((count + 1))
	done

	load_pane "$pane"
	[[ $ACTIVE =~ ^[0-9]+$ ]] && ((ACTIVE >= 1 && ACTIVE <= N)) && old_active_sid=${SID[ACTIVE]-}

	for ((j = 0; j < count; j++)); do
		i=$(find_slot "${tab_sid[j]}")
		raw=$(sanitize_name "${tab_title[j]}")
		if [[ -n $i ]]; then
			new_sid+=("${SID[i]}")
			new_kind+=(opencode)
			[[ -n $raw ]] || raw=${RAW[i]-}
			new_notified+=("${NOTIFIED[i]-}")
			new_since+=("${SINCE[i]-}")
			old_state+=("${STATE[i]-}")
			# A known tab whose wait only became visible now.
			if [[ ${tab_status[j]} == pending && ${STATE[i]-} != blocked ]]; then
				read -r verb next notify <<<"$(agent_transition "${STATE[i]-}" opencode tab.pending)"
				new_state+=("$next")
				new_event+=("$(event_label opencode tab.pending)")
				[[ $notify == 1 ]] && pending_notify+=("$((j + 1))")
			else
				new_state+=("${STATE[i]-}")
				new_event+=("${EVENT[i]-}")
			fi
		else
			read -r verb next notify <<<"$(agent_transition '' opencode tab.opened "${tab_status[j]}")"
			new_sid+=("${tab_sid[j]}")
			new_kind+=(opencode)
			new_state+=("$next")
			new_event+=("$(event_label opencode tab.opened "${tab_status[j]}")")
			new_notified+=('')
			new_since+=('')
			old_state+=('')
		fi
		[[ -n $raw ]] || raw=$(fallback_name "$pane" "$cwd")
		new_raw+=("$raw")
		[[ ${tab_sid[j]} == "$active_sid" ]] && new_active=$((j + 1))
	done

	N=$count
	SID=()
	KIND=()
	STATE=()
	RAW=()
	EVENT=()
	NOTIFIED=()
	SINCE=()
	for ((j = 0; j < count; j++)); do
		SID[j + 1]=${new_sid[j]}
		KIND[j + 1]=${new_kind[j]}
		RAW[j + 1]=${new_raw[j]}
		EVENT[j + 1]=${new_event[j]}
		NOTIFIED[j + 1]=${new_notified[j]}
		SINCE[j + 1]=${new_since[j]}
		STATE[j + 1]=${old_state[j]}
		set_state "$((j + 1))" "${new_state[j]}"
	done
	ACTIVE=${new_active:-1}

	# Focusing a different tab inside the TUI means the user is looking at it.
	if ((N > 0)) && [[ -n $new_active && $active_sid != "$old_active_sid" ]]; then
		read -r verb next notify <<<"$(agent_transition "${STATE[ACTIVE]}" opencode tab.focused)"
		if [[ $verb == set ]]; then
			set_state "$ACTIVE" "$next"
			EVENT[ACTIVE]=$(event_label opencode tab.focused)
		fi
	fi

	store_pane "$pane"
	after_pane_change "$pane"
	for slot in ${pending_notify[@]+"${pending_notify[@]}"}; do
		notify_agent "$pane" "$slot" "${STATE[slot]}"
	done
}

refresh_name() {
	local pane=$1 sid=$2 claude_bin=$3 out name i
	[[ -n $pane && -n $sid && -n $claude_bin ]] || return 0
	if command -v timeout >/dev/null 2>&1; then
		out=$(timeout 2 "$claude_bin" agents --json 2>/dev/null || true)
	else
		out=$("$claude_bin" agents --json 2>/dev/null || true)
	fi
	[[ -n $out ]] || return 0
	# `claude agents --json` prints an array; attach resolution reads it the
	# same way.
	name=$(printf '%s' "$out" | jq -r --arg id "$sid" '
		.[] | select((.sessionId // .session_id // .id) == $id)
		| (.name // .title // empty)
	' 2>/dev/null | head -n 1)
	[[ -n $name ]] || return 0
	name=$(sanitize_name "$name")
	[[ -n $name ]] || return 0
	load_pane "$pane"
	i=$(find_slot "$sid")
	[[ -n $i ]] || return 0
	set_pane_opt "$pane" "@agent_${i}_name" "$(escape_hash "$name")"
	set_pane_opt "$pane" "@agent_${i}_name_raw" "$name"
	refresh_clients
}

# --- tmux-side commands ---------------------------------------------------------

reconcile() {
	local sid pane n
	while read -r pane n; do
		[[ -n $pane ]] || continue
		# Rebuild the pane summary from its slots.
		if [[ $n =~ ^[0-9]+$ ]] && ((n > 0)); then
			load_pane "$pane"
			write_pane_summary "$pane"
			flush
		fi
	done < <(tmux_do list-panes -a -F '#{pane_id} #{@agent_n}' || true)
	while IFS= read -r sid; do
		[[ -n $sid ]] && recompute_session "$sid"
	done < <(tmux_do list-sessions -F '#{session_id}' || true)
	refresh_clients
}

# --- Attached background sessions ---------------------------------------------

# Print `claude agents --json` once per run.
claude_agents_json() {
	local claude_bin=${CLAUDE_BIN:-}
	if [[ -z ${AGENTS_JSON+x} ]]; then
		[[ -n $claude_bin ]] || claude_bin=$(command -v claude 2>/dev/null || true)
		AGENTS_JSON=''
		if [[ -n $claude_bin ]]; then
			if command -v timeout >/dev/null 2>&1; then
				AGENTS_JSON=$(timeout 2 "$claude_bin" agents --json 2>/dev/null || true)
			else
				AGENTS_JSON=$("$claude_bin" agents --json 2>/dev/null || true)
			fi
		fi
	fi
	printf '%s' "$AGENTS_JSON"
}

# Print "<pane> <arg>" for each pane running a Claude viewer of a background
# session (`claude ... attach <arg>`), skipping suspended viewers.
attach_viewers() {
	local panes
	panes=$(tmux_do list-panes -a -F '#{pane_pid} #{pane_id}' || true)
	[[ -n $panes ]] || return 0
	ps -A -ww -o pid= -o ppid= -o stat= -o args= 2>/dev/null | awk -v panes="$panes" '
		BEGIN {
			n = split(panes, rows, "\n")
			for (k = 1; k <= n; k++) { split(rows[k], f, " "); pane[f[1]] = f[2] }
		}
		{
			parent[$1] = $2
			if ($3 ~ /T/) next
			cmd = $4
			sub(/.*\//, "", cmd)
			if (cmd != "claude") next
			line = $0
			sub(/^ *[0-9]+ +[0-9]+ +[^ ]+ +/, "", line)
			at = index(line " ", " attach ")
			if (!at) next
			arg = substr(line, at + 8)
			sub(/^ +/, "", arg)
			sub(/ +$/, "", arg)
			if (arg != "") viewer[$1] = arg
		}
		END {
			for (pid in viewer) {
				p = pid
				for (hops = 0; hops < 32 && p != "" && p != 0; hops++) {
					if (p in pane) { print pane[p] " " viewer[pid]; break }
					p = parent[p]
				}
			}
		}'
}

# Print the background session ARG resolves to: the session whose short ID is
# ARG, else a session ID starting with it, else the only session whose name
# contains it, ignoring case.  SID, when given, is checked first without
# asking Claude Code.  The short ID is matched as Claude Code documents it;
# that it also starts the session ID is observed, not documented.
attach_session() {
	local arg=$1 sid=${2-}
	[[ -n $arg ]] || return 0
	if [[ -n $sid && $sid == "$arg"* ]]; then
		printf '%s' "$sid"
		return 0
	fi
	claude_agents_json | jq -r --arg a "$arg" '
		[if type == "array" then .[] else empty end | select(.sessionId)] as $all
		| [$all[] | select(.id == $a)] as $short
		| [$all[] | select(.sessionId | startswith($a))] as $ids
		| if ($short | length) == 1 then $short[0].sessionId
		  elif ($ids | length) == 1 then $ids[0].sessionId
		  else [$all[] | select((.name // "") | ascii_downcase | contains($a | ascii_downcase))] as $names
		  | if ($names | length) == 1 then $names[0].sessionId else empty end
		  end' 2>/dev/null || true
}

# A hook from background session SID: apply it to every pane showing the
# session and forget it in panes that no longer do.  EVENT_SID is the session
# ID the event itself carries, empty for a subagent.
report_background() {
	local kind=$1 event=$2 detail=$3 sid=$4 event_sid=$5 name=$6 cwd=$7 refresh=$8 actor=${9-}
	local pane arg shown=' '
	[[ -n $sid ]] || return 0
	while read -r pane arg; do
		[[ -n $pane && $(attach_session "$arg" "$sid") == "$sid" ]] && shown+="$pane "
	done < <(attach_viewers)
	while read -r pane arg; do
		[[ $arg == "$sid" && $shown != *" $pane "* ]] && remove_pane "$pane"
	done < <(tmux_do list-panes -a -F '#{pane_id} #{@agent_attached}' || true)
	for pane in $shown; do
		report_event "$pane" "$kind" "$event" "$detail" "$event_sid" "$name" "$cwd" "$refresh" "$actor" "$sid"
	done
}

# Add the session a client's pane just attached to, and forget attached
# sessions no longer shown.  Only scans processes when a client views a
# Claude pane or some pane holds an attached session.
sync_attached() {
	local active pane cmd held scan=0 viewers='' arg sid state name current
	active=" $(tmux_do list-clients -F '#{pane_id}' | tr '\n' ' ') "
	held=''
	while read -r pane cmd sid; do
		[[ -n $pane ]] || continue
		[[ -n $sid ]] && held+="$pane $sid"$'\n' && scan=1
		[[ $cmd == claude && $active == *" $pane "* ]] && scan=1
	done < <(tmux_do list-panes -a -F '#{pane_id} #{pane_current_command} #{@agent_attached}' || true)
	((scan)) || return 0
	viewers=$(attach_viewers)

	while read -r pane sid; do
		[[ -n $pane ]] || continue
		arg=$(awk -v p="$pane" '$1 == p { sub(/^[^ ]+ /, ""); print; exit }' <<<"$viewers")
		[[ -n $arg && $(attach_session "$arg" "$sid") == "$sid" ]] || remove_pane "$pane"
	done <<<"$held"

	while read -r pane arg; do
		[[ -n $pane && $active == *" $pane "* ]] || continue
		current=$(get_pane_opt "$pane" @agent_attached)
		[[ -n $current && $(attach_session "$arg" "$current") == "$current" ]] && continue
		sid=$(attach_session "$arg")
		[[ -n $sid ]] || continue
		IFS=$US read -r state name <<<"$(claude_agents_json | jq -r --arg s "$sid" --arg us "$US" '
			.[] | select(.sessionId == $s) | "\(.state // "")\($us)\(.name // "")"' 2>/dev/null | head -n 1)"
		report_event "$pane" claude Attached "$state" "$sid" "$name" '' 0 '' "$sid"
	done <<<"$viewers"
}

focus_agents() {
	local client pane slot verb next notify
	sync_attached
	while IFS=' ' read -r client pane; do
		[[ -n $pane ]] || continue
		load_pane "$pane"
		((N > 0)) || continue
		slot=$ACTIVE
		[[ $slot =~ ^[0-9]+$ ]] && ((slot >= 1 && slot <= N)) || slot=1
		read -r verb next notify <<<"$(agent_transition "${STATE[slot]-}" tmux viewed)"
		[[ $verb == set && $next != "${STATE[slot]-}" ]] || continue
		set_state "$slot" "$next"
		queue set-option -p -t "$pane" "@agent_${slot}_state" "$next"
		queue set-option -p -t "$pane" "@agent_${slot}_since" "${SINCE[slot]}"
		write_pane_summary "$pane"
		after_pane_change "$pane"
	done < <(tmux_do list-clients -F '#{client_name} #{pane_id}' || true)
	refresh_clients
}

# Ask the OpenCode TUI in PANE to focus the tab of agent session SID.
send_focus() {
	local pane=$1 sid=$2 socket
	socket=$(get_pane_opt "$pane" @agent_socket)
	[[ -n $socket && -S $socket ]] || return 0
	focus_socket_write "$socket" "focus $sid"
}

focus_socket_write() {
	local socket=$1 line=$2
	if command -v python3 >/dev/null 2>&1; then
		python3 -I -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(1)
s.connect(sys.argv[1])
s.sendall((sys.argv[2] + "\n").encode())
s.close()
' "$socket" "$line" >/dev/null 2>&1 || true
	elif command -v nc >/dev/null 2>&1; then
		printf '%s\n' "$line" | nc -U -w 1 "$socket" >/dev/null 2>&1 || true
	fi
}

# ROW is a sidebar range: %P:<slot>, %P:+ (overflow) or a bare pane target.
select_agent() {
	local row=${1-} pane slot sid
	[[ -n $row ]] || return 0
	if [[ $row == keys ]]; then
		toggle_keys
		return 0
	fi
	pane=${row%%:*}
	slot=''
	[[ $row == *:* ]] && slot=${row#*:}
	tmux_ok select-window -t "$pane"
	tmux_ok select-pane -t "$pane"
	if [[ $slot =~ ^[0-9]+$ ]]; then
		sid=$(get_pane_opt "$pane" "@agent_${slot}_sid")
		if [[ $(get_pane_opt "$pane" "@agent_${slot}_kind") == opencode && -n $sid ]]; then
			send_focus "$pane" "$sid"
		fi
	fi
	focus_agents
}

# --- Rename -------------------------------------------------------------------

# Send LINE to the Unix socket SOCKET and print the first reply line, waiting
# at most WAIT seconds.  With WAIT 0 the line is sent and no reply is read.
socket_request() {
	local socket=$1 line=$2 wait=$3
	if command -v python3 >/dev/null 2>&1; then
		python3 -I -c '
import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.settimeout(max(float(sys.argv[3]), 1))
s.connect(sys.argv[1])
s.sendall((sys.argv[2] + "\n").encode())
if float(sys.argv[3]) == 0:
    s.close()
    sys.exit(0)
data = b""
try:
    while b"\n" not in data:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
except socket.timeout:
    pass
sys.stdout.write(data.decode(errors="replace").split("\n")[0])
' "$socket" "$line" "$wait" 2>/dev/null
	elif command -v nc >/dev/null 2>&1; then
		printf '%s\n' "$line" | nc -U -w "$((wait > 0 ? wait : 1))" "$socket" 2>/dev/null | head -n 1
	else
		return 1
	fi
}

# Print the session registry file of the running Claude session SID: Claude
# Code keeps one JSON file per running session (ADR-0009).
claude_registry_file() {
	local sid=$1 dir=${CLAUDE_CONFIG_DIR:-$HOME/.claude}/sessions
	[[ -d $dir ]] || return 0
	find "$dir" -maxdepth 1 -name '*.json' -exec jq -r --arg id "$sid" \
		'select(.sessionId == $id) | input_filename' {} + 2>/dev/null | head -n 1
}

# Print field FIELD of the running Claude session SID from its registry file.
claude_registry_field() {
	local file
	file=$(claude_registry_file "$1")
	[[ -n $file ]] || return 0
	jq -r --arg f "$2" '.[$f] // empty' "$file" 2>/dev/null
}

# Rename the running Claude session SID through its messaging socket.  The
# rename message is internal to Claude Code (ADR-0009), so the rename counts
# only once the session registry shows the new name.
rename_claude() {
	local sid=$1 name=$2 socket i
	socket=$(claude_registry_field "$sid" messagingSocketPath)
	if [[ -z $socket || ! -S $socket ]]; then
		RENAME_ERROR="no running Claude session $sid has a messaging socket"
		return 1
	fi
	socket_request "$socket" "$(jq -cn --arg name "$name" '{type: "control", action: "rename", name: $name}')" 0 >/dev/null
	for ((i = 0; i < 30; i++)); do
		[[ $(claude_registry_field "$sid" name) == "$name" ]] && return 0
		sleep 0.1
	done
	RENAME_ERROR="Claude did not apply the rename; its internal rename message may have changed"
	return 1
}

# Ask the OpenCode adapter in PANE to rename agent session SID.  It answers
# "ok" or "error <reason>".
rename_opencode() {
	local pane=$1 sid=$2 name=$3 socket reply
	socket=$(get_pane_opt "$pane" @agent_socket)
	if [[ -z $socket || ! -S $socket ]]; then
		RENAME_ERROR='the OpenCode adapter of this pane is not listening'
		return 1
	fi
	reply=$(socket_request "$socket" "rename $sid $name" 3)
	[[ $reply == ok ]] && return 0
	RENAME_ERROR=${reply#error }
	[[ -n $reply ]] || RENAME_ERROR='the OpenCode adapter did not confirm the rename; restart OpenCode to load the current adapter'
	return 1
}

# Rename the agent on sidebar row ROW (%P:<slot>) to NAME in the agent itself,
# then show the new name.  A rename the agent does not confirm fails loudly
# and leaves the name unchanged.  CLIENT receives the error message.
rename_agent() {
	local row=$1 name=$2 client=${3-} pane slot kind sid
	RENAME_ERROR=''
	name=$(sanitize_name "$name")
	[[ -n $row && -n $name ]] || return 0
	pane=${row%%:*}
	slot=${row#*:}
	[[ $row == *:* && $slot =~ ^[0-9]+$ ]] || return 0
	kind=$(get_pane_opt "$pane" "@agent_${slot}_kind")
	sid=$(get_pane_opt "$pane" "@agent_${slot}_sid")
	if [[ -z $sid ]]; then
		RENAME_ERROR='this agent has no session ID yet'
	else
		case "$kind" in
		claude) rename_claude "$sid" "$name" ;;
		opencode) rename_opencode "$pane" "$sid" "$name" ;;
		*) RENAME_ERROR="unknown agent kind: $kind" ;;
		esac
	fi
	if [[ -n $RENAME_ERROR ]]; then
		printf 'tmux-orchestrator: rename failed: %s\n' "$RENAME_ERROR" >&2
		tmux_ok display-message ${client:+-c "$client"} -d 5000 "tmux-orchestrator: rename failed: $(escape_hash "$RENAME_ERROR")"
		return 1
	fi
	# The slot may have changed while the agent renamed itself.
	[[ $(get_pane_opt "$pane" "@agent_${slot}_sid") == "$sid" ]] || return 0
	set_pane_opt "$pane" "@agent_${slot}_name" "$(escape_hash "$name")"
	set_pane_opt "$pane" "@agent_${slot}_name_raw" "$name"
	refresh_clients
}

# Open a rename prompt in CLIENT for the agent on sidebar row ROW.  The answer
# reaches the reporter through tmux options, never through a shell command;
# %%% keeps it literal inside the quotes.  The template holds no pane ID,
# because tmux reads %<n> in it as an answer.
rename_prompt() {
	local row=${1-} client=${2-} pane slot kind name cmd
	pane=${row%%:*}
	slot=${row#*:}
	[[ $row == *:* && $slot =~ ^[0-9]+$ ]] || return 0
	kind=$(get_pane_opt "$pane" "@agent_${slot}_kind")
	[[ -n $kind ]] || return 0
	name=$(get_pane_opt "$pane" "@agent_${slot}_name_raw")
	cmd="'$SELF_DIR/tmux-orchestrator' rename"
	[[ -n ${TMUX_SOCKET:-} ]] && cmd="TMUX_SOCKET=$(printf '%q' "$TMUX_SOCKET") $cmd"
	tmux_ok set-option -g @tmux-orchestrator-rename-row "$row"
	tmux_ok set-option -g @tmux-orchestrator-rename-client "$client"
	tmux_ok command-prompt -b -l ${client:+-t "$client"} -I "$(escape_hash "$name")" -p "rename $kind agent:" \
		"set-option -g @tmux-orchestrator-rename-name \"%%%\" ; run-shell -b \"$cmd\""
}

# Print the key bindings that call the reporter, one per line as
# "<table> <key>  <subcommand>", escaped for the sidebar.  The sidebar's own
# click bindings are fixed mouse actions, so they are left out.
keys_list() {
	local table key cmd sub
	while IFS='|' read -r table key cmd; do
		[[ $table == root && ( $key == MouseDown1Status || $key == DoubleClick1Status ) ]] && continue
		case "$cmd" in
		*'#{@tmux-orchestrator-reporter}'*) sub=${cmd#*'#{@tmux-orchestrator-reporter}'} ;;
		*bin/tmux-orchestrator*) sub=${cmd#*bin/tmux-orchestrator} ;;
		*) continue ;;
		esac
		sub=${sub#\'}
		sub=${sub%%[\"\']*}
		sub=${sub# }
		printf '%s %s  %s\n' "$table" "$key" "$(escape_hash "$sub")"
	done < <(tmux_do list-keys -F '#{key_table}|#{key_string}|#{key_command}' || true)
}

# Open or close the keys panel for every client.  Bindings are read on each
# open so ones added after the plugin loaded are listed too.
toggle_keys() {
	local list
	if [[ $(get_global @tmux-orchestrator-keys) == 1 ]]; then
		tmux_ok set-option -gu @tmux-orchestrator-keys
	else
		list=$(keys_list)
		[[ -n $list ]] || list='no key bindings'
		tmux_ok set-option -g @tmux-orchestrator-keys-list "#[fg=colour8]${list//$'\n'/#[nl]}#[default]#[nl]"
		tmux_ok set-option -g @tmux-orchestrator-keys 1
	fi
	refresh_clients
}

gc() {
	local pane dead n
	while read -r pane dead n; do
		[[ -n $pane ]] || continue
		if [[ $dead == 1 && -n $n ]]; then
			remove_pane "$pane"
		fi
	done < <(tmux_do list-panes -a -F '#{pane_id} #{pane_dead} #{@agent_n}' || true)
	reconcile
}

toggle_sidebar() {
	local enabled side
	enabled=$(get_global @tmux-orchestrator-enabled)
	if [[ $enabled == 0 ]]; then
		enabled=1
		side=$(get_global @tmux-orchestrator-side)
		[[ $side == left || $side == right ]] || side=left
	else
		enabled=0
		side=off
	fi
	tmux_ok set-option -g @tmux-orchestrator-enabled "$enabled"
	tmux_ok set-option -g side-status "$side"
	refresh_clients
}

# Send an OSC 9 notification to the terminal of the most recently active
# client, which reaches the desktop even over SSH.
# shortcut: writes to the client tty beside tmux's own output, so it could land
# inside a frame tmux is drawing; move to a tmux command if one appears.
notify_terminal() {
	local summary tty
	summary="$(state_icon "$2") Agent $2: $1"
	# Control-mode clients speak a line protocol on their tty, so skip them.
	tty=$(tmux_do list-clients -f '#{!=:#{client_control_mode},1}' -F '#{client_activity} #{client_tty}' | sort -rn | head -n 1)
	tty=${tty#* }
	[[ -n $tty && -w $tty ]] || return 0
	printf '\033]9;%s\007' "$summary" >"$tty" 2>/dev/null || true
}

notify_status() {
	local paused desktop channel default value
	paused=$(get_global @tmux-orchestrator-notify-paused)
	if ! channel_on tmux on && ! channel_on desktop on && ! channel_on terminal off; then
		printf 'notifications: off\n'
	elif [[ $paused == 1 ]]; then
		printf 'notifications: paused\n'
	else
		printf 'notifications: active\n'
	fi
	for channel in tmux desktop terminal; do
		default=on
		[[ $channel == terminal ]] && default=off
		value=off
		channel_on "$channel" "$default" && value=on
		if [[ $channel == desktop ]]; then
			desktop=$(desktop_command)
			printf 'desktop: %s (%s)\n' "$value" "${desktop:-unavailable}"
		else
			printf '%s: %s\n' "$channel" "$value"
		fi
	done
}

cleanup_all() {
	local pane sid hook name
	while IFS= read -r pane; do
		[[ -n $pane ]] || continue
		clear_pane "$pane"
		flush
	done < <(tmux_do list-panes -a -F '#{pane_id}' || true)
	while IFS= read -r sid; do
		[[ -n $sid ]] || continue
		for name in @agent_count @agent_rollup @agent_blocked_n @agent_error_n @agent_done_n @agent_waiting_w; do
			unset_session_opt "$sid" "$name"
		done
	done < <(tmux_do list-sessions -F '#{session_id}' || true)
	for hook in 'after-select-pane[90]' 'after-select-window[90]' \
		'client-session-changed[90]' 'session-closed[90]'; do
		tmux_ok set-hook -gu "$hook"
	done
	tmux_ok set-hook -gwu 'pane-exited[90]'
	tmux_ok set-hook -gwu 'pane-died[90]'
	tmux_ok set-option -g side-status off
	refresh_clients
}

# The OpenCode adapter is a link to this copy's plugins/opencode, so updating or
# switching the tmux plugin updates it too (ADR-0007).  Only a link into a
# plugins/opencode directory is ours to replace.
opencode_path_is_ours() {
	[[ -L $1 && $(readlink -- "$1") == */plugins/opencode ]]
}

install_opencode() {
	local home=${HOME} uninstall=0 quiet=0 src dest
	while (($#)); do
		case "$1" in
		--home) home=$2; shift 2 ;;
		--uninstall) uninstall=1; shift ;;
		--quiet) quiet=1; shift ;;
		*) shift ;;
		esac
	done
	dest="$home/.config/opencode/plugins/tmux-orchestrator"
	src="$ROOT_DIR/plugins/opencode"

	if [[ -e $dest || -L $dest ]] && ! opencode_path_is_ours "$dest"; then
		printf 'left untouched: %s was not created by tmux-orchestrator\n' "$dest" >&2
		return 0
	fi
	if ((uninstall)); then
		rm -f -- "$dest"
		((quiet)) || printf 'removed %s\n' "$dest"
		return 0
	fi
	if [[ ! -f $src/tui.js ]]; then
		printf 'missing %s\n' "$src/tui.js" >&2
		return 1
	fi
	# Already linked here: nothing to do.
	[[ -L $dest && $(readlink -- "$dest") == "$src" ]] && return 0
	rm -f -- "$dest"
	mkdir -p -- "$(dirname "$dest")"
	ln -s -- "$src" "$dest"
	((quiet)) || printf 'linked %s -> %s\n' "$dest" "$src"
}

# A call from an adapter speaking another protocol is ignored, and attached
# clients are told once per tmux server to update the tmux plugin.
protocol_ok() {
	local version=${1-} client
	[[ -z $version || $version == "$PROTOCOL" ]] && return 0
	if [[ $(get_global @tmux-orchestrator-protocol-warned) != "$version" ]]; then
		tmux_ok set-option -g @tmux-orchestrator-protocol-warned "$version"
		while IFS= read -r client; do
			[[ -n $client ]] && tmux_ok display-message -c "$client" \
				"tmux-orchestrator: update the tmux plugin (adapter protocol $version)"
		done < <(tmux_do list-clients -F '#{client_name}' || true)
	fi
	return 1
}

usage() {
	cat <<'EOF'
usage: tmux-orchestrator <command> [options]

  report        report an agent event (adapter commands accept --protocol N)
  tabs          report the OpenCode tabs of a pane
  remove        forget the agents of a pane
  register      store the OpenCode control socket of a pane
  refresh-name  re-read the agent name from `claude agents --json`
  focus         update the agents of the panes clients view
  select ROW    act on a sidebar row
  rename ROW NAME  rename the agent on a sidebar row (%P:<slot>) in the agent
  rename-prompt ROW CLIENT  ask CLIENT for a new name for that agent
  reconcile     rebuild session summaries
  gc            drop agents of dead panes and reconcile
  toggle        enable or disable the sidebar
  notify        pause | resume | toggle | status
  cleanup       clear state, hooks and the sidebar
  install       [opencode] [--home DIR] [--quiet]
  uninstall     [opencode] [--home DIR] [--quiet]

report options:
  --pane ID                pane to report on (default: $TMUX_PANE)
  --kind KIND              agent kind: claude or opencode
  --event EVENT            adapter event name
  --detail D               event detail: tool name, tab or attach state
  --session-id ID          agent session id
  --name NAME              agent name shown in the sidebar
  --cwd DIR                agent working directory
  --refresh                refresh the name from Claude in the background
  --agent ID               subagent actor id (default: main)
  --background             event without a pane: apply it to every viewer
  --background-session ID  background session id (default: --session-id)

tabs options:
  --pane ID                pane whose tabs are reported
  --active ID              active tab id
  --tab ID STATUS TITLE    one tab, repeatable
  --cwd DIR                tab working directory

remove and register options:
  --pane ID                pane to act on (default: $TMUX_PANE)
  --socket PATH            OpenCode control socket (register only)

refresh-name options:
  --pane ID                pane whose agent is named
  --session-id ID          session id to look up
  --claude-bin PATH        Claude binary to ask

install and uninstall options:
  --home DIR               OpenCode config home (default: $HOME)
  --quiet                  print nothing on success

Every adapter command accepts --protocol N; this reporter speaks 1.
EOF
}

main() {
	local command=${1-} protocol='' args=()
	shift || true
	# Every adapter call carries --protocol; strip it before the command parses.
	while (($#)); do
		if [[ $1 == --protocol ]]; then
			protocol=${2-}
			shift 2 || shift
		else
			args+=("$1")
			shift
		fi
	done
	set -- ${args[@]+"${args[@]}"}
	case "$command" in
	report | tabs | remove | register) protocol_ok "$protocol" || return 0 ;;
	esac
	case "$command" in
	report)
		local pane='' kind='' event='' detail='' sid='' name='' cwd='' refresh=0 agent='' background=0 bg_sid=''
		while (($#)); do
			case "$1" in
			--pane) pane=$2; shift 2 ;;
			--background) background=1; shift ;;
			--background-session) bg_sid=$2; shift 2 ;;
			--kind) kind=$2; shift 2 ;;
			--event) event=$2; shift 2 ;;
			--detail) detail=$2; shift 2 ;;
			--session-id) sid=$2; shift 2 ;;
			--name) name=$2; shift 2 ;;
			--cwd) cwd=$2; shift 2 ;;
			--refresh) refresh=1; shift ;;
			# Adapters before ADR-0010 send it; interrupts no longer use it.
			--transcript) shift 2 ;;
			--agent) agent=$2; shift 2 ;;
			*) shift ;;
			esac
		done
		if ((background)); then
			report_background "$kind" "$event" "$detail" "${bg_sid:-$sid}" "$sid" "$name" "$cwd" "$refresh" "$agent"
			return 0
		fi
		pane=${pane:-${TMUX_PANE:-}}
		report_event "$pane" "$kind" "$event" "$detail" "$sid" "$name" "$cwd" "$refresh" "$agent"
		;;
	tabs)
		local pane='' active='' cwd='' tabs=()
		while (($#)); do
			case "$1" in
			--pane) pane=$2; shift 2 ;;
			--active) active=$2; shift 2 ;;
			--cwd) cwd=$2; shift 2 ;;
			--tab) tabs+=("$2" "$3" "$4"); shift 4 ;;
			*) shift ;;
			esac
		done
		pane=${pane:-${TMUX_PANE:-}}
		[[ -n $pane ]] && apply_tabs "$pane" "$active" "$cwd" "${tabs[@]}"
		;;
	remove)
		local pane=''
		while (($#)); do
			case "$1" in
			--pane) pane=$2; shift 2 ;;
			*) shift ;;
			esac
		done
		pane=${pane:-${TMUX_PANE:-}}
		[[ -n $pane ]] && remove_pane "$pane"
		;;
	register)
		local pane='' socket=''
		while (($#)); do
			case "$1" in
			--pane) pane=$2; shift 2 ;;
			--socket) socket=$2; shift 2 ;;
			*) shift ;;
			esac
		done
		pane=${pane:-${TMUX_PANE:-}}
		[[ -n $pane && -n $socket ]] && set_pane_opt "$pane" @agent_socket "$socket"
		;;
	watch-interrupt)
		local pane='' sid='' token=''
		while (($#)); do
			case "$1" in
			--pane) pane=$2; shift 2 ;;
			--session-id) sid=$2; shift 2 ;;
			--token) token=$2; shift 2 ;;
			*) shift ;;
			esac
		done
		watch_interrupt "$pane" "$sid" "$token"
		;;
	refresh-name)
		local pane='' sid='' bin=''
		while (($#)); do
			case "$1" in
			--pane) pane=$2; shift 2 ;;
			--session-id) sid=$2; shift 2 ;;
			--claude-bin) bin=$2; shift 2 ;;
			*) shift ;;
			esac
		done
		refresh_name "$pane" "$sid" "$bin"
		;;
	focus) focus_agents ;;
	select) select_agent "${1-}" ;;
	rename-prompt) rename_prompt "${1-}" "${2-}" ;;
	rename)
		if (($#)); then
			rename_agent "${1-}" "${2-}"
		else
			# The answer of a rename prompt, left in tmux options.
			local row client name
			row=$(get_global @tmux-orchestrator-rename-row)
			client=$(get_global @tmux-orchestrator-rename-client)
			name=$(get_global @tmux-orchestrator-rename-name)
			tmux_ok set-option -gu @tmux-orchestrator-rename-row \; set-option -gu @tmux-orchestrator-rename-client \; set-option -gu @tmux-orchestrator-rename-name
			rename_agent "$row" "$name" "$client"
		fi
		;;
	reconcile) reconcile ;;
	gc) gc ;;
	toggle) toggle_sidebar ;;
	notify)
		case "${1-}" in
		pause)
			tmux_ok set-option -g @tmux-orchestrator-notify-paused 1
			printf 'notifications paused\n'
			;;
		resume)
			tmux_ok set-option -gu @tmux-orchestrator-notify-paused
			printf 'notifications resumed\n'
			;;
		status | '') notify_status ;;
		toggle)
			if [[ $(get_global @tmux-orchestrator-notify-paused) == 1 ]]; then
				tmux_ok set-option -gu @tmux-orchestrator-notify-paused
				printf 'notifications resumed\n'
			else
				tmux_ok set-option -g @tmux-orchestrator-notify-paused 1
				printf 'notifications paused\n'
			fi
			;;
		*) printf 'usage: tmux-orchestrator notify pause|resume|toggle|status\n' >&2; return 2 ;;
		esac
		;;
	cleanup) cleanup_all ;;
	install) install_opencode "$@" ;;
	uninstall) install_opencode --uninstall "$@" ;;
	help | -h | --help | '') usage ;;
	*) printf 'unknown command: %s\n' "$command" >&2; usage >&2; return 2 ;;
	esac
}

main "$@"
