# Sidebar format fragments.  tmux-orchestrator.tmux reads the key=value lines
# below and assembles side-status-format at load time (ADR-0004):
#   {STATE}  is replaced by the option holding a state, inside icon.
#   {ICON:x} is replaced by the icon fragment for option x.
#   {I}      is replaced by the slot number, inside agent_row.
#   {AGENT_ROWS} is replaced by agent_row for slots 1 to slots.
# The reporter reads slots too: agents past it share the overflow row.
slots=9
icon=#{?#{==:#{{STATE}},working},#[fg=yellow]◐,#{?#{==:#{{STATE}},blocked},#[fg=red]●,#{?#{==:#{{STATE}},error},#[fg=red]×,#{?#{==:#{{STATE}},done},#[fg=colour37]✓,#{?#{==:#{{STATE}},idle},#[fg=green]○,#[fg=colour8]·}}}}}
agent_row=#{?#{@agent_{I}_kind},#[range=user|#{pane_id}:{I} #{?#{&&:#{&&:#{window_active},#{pane_active}},#{==:#{@agent_active},{I}}},list=focus,}]{ICON:@agent_{I}_state} #[fg=default]#{=/#{e|-:#{side-status-width},13}/…:@agent_{I}_name} #[fg=colour8]#{@agent_{I}_kind}#[norange list=on default]#[nl],}
more_row=#{?#{@agent_more_n},#[range=user|#{pane_id}:+]{ICON:@agent_more_state} #[fg=default]+#{@agent_more_n} more#[norange list=on default]#[nl],}
layout=Sessions#[nl]#[list=on]#{S:#{?#{>:#{@agent_count},0},#[range=session|#{session_id}]#{?#{==:#{session_name},#{client_session}},#[fg=green]▸,#[fg=default] }{ICON:@agent_rollup} #[fg=default]#{=/#{e|-:#{side-status-width},9}/…:session_name} #[fg=colour8]#{@agent_count}#[norange list=on default]#[nl],}}#[nolist]#[nl]Agents#[nl]#[list=on]#{S:#{?#{==:#{session_name},#{client_session}},#{W:#{P:#{?#{@agent_n},{AGENT_ROWS}{MORE_ROW},}}},}}#[nolist]#{S:#{?#{==:#{session_name},#{client_session}},#{?#{||:#{==:#{@agent_count},0},#{!:#{@agent_count}}},#[fg=colour8]no agents in this session#[nl],},}}
