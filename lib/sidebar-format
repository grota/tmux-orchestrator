# Sidebar format fragments.  tmux-orchestrator.tmux reads the key=value lines
# below and assembles side-status-format at load time (ADR-0004):
#   {STATE}  is replaced by the option holding a state, inside icon.
#   {ICON:x} is replaced by the icon fragment for option x.
#   {I}      is replaced by the slot number, inside agent_row.
#   {AGENT_ROWS} is replaced by agent_row for slots 1 to slots.
# @tmux-orchestrator-time off hides the time in state, live.
# The reporter reads slots too: agents past it share the overflow row.
slots=9
icon=#{?#{==:#{{STATE}},working},#[fg=yellow]◐,#{?#{==:#{{STATE}},blocked},#[fg=red]●,#{?#{==:#{{STATE}},error},#[fg=red]×,#{?#{==:#{{STATE}},done},#[fg=colour37]✓,#{?#{==:#{{STATE}},idle},#[fg=green]○,#[fg=colour8]·}}}}}
agent_row=#{?#{@agent_{I}_kind},#[range=user|#{pane_id}:{I} #{?#{&&:#{&&:#{window_active},#{pane_active}},#{==:#{@agent_active},{I}}},list=focus,}]{ICON:@agent_{I}_state} #[fg=default]#{=/#{e|-:#{side-status-width},#{?#{==:#{@tmux-orchestrator-time},off},4,11}}/…:@agent_{I}_name}#{?#{&&:#{@agent_{I}_since},#{!=:#{@tmux-orchestrator-time},off}},#[align=right fg=colour8]#{t/r:@agent_{I}_since} #[align=left],}#[norange list=on default]#[nl]#[range=user|#{pane_id}:{I}]  #[fg=colour8]#{@agent_{I}_kind}#[norange list=on default]#[nl],}
more_row=#{?#{@agent_more_n},#[range=user|#{pane_id}:+]{ICON:@agent_more_state} #[fg=default]+#{@agent_more_n} more#[norange list=on default]#[nl],}
layout=Sessions#[nl]#[list=on]#{S:#{?#{>:#{@agent_count},0},#[range=session|#{session_id}]#{?#{==:#{session_name},#{client_session}},#[fg=green]▸,#[fg=default] }{ICON:@agent_rollup} #[fg=default]#{=/#{e|-:#{side-status-width},#{e|+:9,#{?#{@agent_waiting_w},#{@agent_waiting_w},0}}}/…:session_name} #{?#{@agent_blocked_n},#[fg=red]●#{@agent_blocked_n} ,}#{?#{@agent_error_n},#[fg=red]×#{@agent_error_n} ,}#{?#{@agent_done_n},#[fg=colour37]✓#{@agent_done_n} ,}#[fg=colour8]#{@agent_count}#[norange list=on default]#[nl],}}#[nolist]#[nl]Agents#[nl]#[list=on]#{S:#{?#{==:#{session_name},#{client_session}},#{W:#{P:#{?#{@agent_n},{AGENT_ROWS}{MORE_ROW},}}},}}#[nolist]#{S:#{?#{==:#{session_name},#{client_session}},#{?#{||:#{==:#{@agent_count},0},#{!:#{@agent_count}}},#[fg=colour8]no agents in this session#[nl],},}}
